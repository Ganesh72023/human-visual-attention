# Root env (used by docker-compose.yml)
# Atlas example (do NOT commit real passwords; URL-encode special characters):
# MONGODB_URI=mongodb+srv://<user>:<urlencoded_password>@<cluster>/<db>?retryWrites=true&w=majority&appName=<appName>
MONGODB_URI=
JWT_SECRET=dev_secret_change_me_1234567890
CORS_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:5000

# Admin seed defaults (optional; you can change these and run `npm run seed:admin` in server)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=adminpassword
ADMIN_NAME=Admin
